{
  "name": "Rust",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "root",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.cargo.targetDir": "target"
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-vscode.cpptools"
      ]
    }
  },
  "postCreateCommand": "cargo --version || true"
}